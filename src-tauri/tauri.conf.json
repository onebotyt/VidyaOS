{
  "$schema": "https://schema.tauri.app/v1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "http://localhost:5000",
    "distDir": "../"
  },
  "package": {
    "productName": "VidyaOS",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["https://*/*", "http://*/*"]
      }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "VidyaOS 2026",
      "icon": [
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "identifier": "com.vidyaos.desktop",
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "VidyaOS Academic Suite",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ]
  }
}
