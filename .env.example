# =============================================================================
# VidyaOS Frontend — Environment Configuration
# =============================================================================
# Copy this file to .env for local development
# These variables are for the FRONTEND dev server only
# DB / JWT secrets belong in the BACKEND repo — never here

# Local dev server port
PORT=5000

# Backend target for API proxying (/api/v1/* and /uploads/*)
# Local development (backend running on your PC):
BACKEND_URL=http://localhost:3000

# Remote cloud backend (uncomment when using Render):
# BACKEND_URL=https://vidyaos-backend.onrender.com
