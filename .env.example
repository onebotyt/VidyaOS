# =============================================================================
# VidyaOS Frontend Environment Configuration
# =============================================================================

# Local dev server port
PORT=5000

# Backend target for API proxying (/api/v1/* and /uploads/*)
# Option 1: Local Backend (Default)
BACKEND_URL=http://localhost:3000

# Option 2: Remote Cloud Backend on Render (Uncomment when working with remote team)
# BACKEND_URL=https://vidyaos-backend.onrender.com
