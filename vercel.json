{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://vidyaos-backend.onrender.com/api/v1/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://vidyaos-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/shared/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/shared/js/:path*"
    },
    {
      "source": "/shared/:path*",
      "destination": "/shared/:path*"
    },
    {
      "source": "/register",
      "destination": "/login/register"
    },
    {
      "source": "/register.html",
      "destination": "/login/register"
    },
    {
      "source": "/login/register.html",
      "destination": "/login/register"
    },
    {
      "source": "/login/student-register.html",
      "destination": "/login/register?role=student"
    },
    {
      "source": "/login/faculty-register.html",
      "destination": "/login/register?role=faculty"
    },
    {
      "source": "/admin",
      "destination": "/admin/academic-structure"
    },
    {
      "source": "/admin/departments",
      "destination": "/admin/academic-structure?tab=departments"
    },
    {
      "source": "/faculty",
      "destination": "/faculty/dashboard"
    },
    {
      "source": "/faculty/analytics",
      "destination": "/faculty/reports?tab=analytics"
    },
    {
      "source": "/faculty/marks",
      "destination": "/faculty/tests"
    },
    {
      "source": "/faculty/attendance/quick",
      "destination": "/faculty/registers"
    },
    {
      "source": "/student",
      "destination": "/student/dashboard"
    },
    {
      "source": "/student/attendance/subjects",
      "destination": "/student/attendance"
    },
    {
      "source": "/:section/:page.css",
      "destination": "/:section/:page/:page.css"
    },
    {
      "source": "/:section/:page.js",
      "destination": "/:section/:page/:page.js"
    }
  ]
}
